{
  "name": "storybook-addon-playground",
  "version": "2.0.1",
  "description": "A playground to enable consumers learn how to use the component library or to reproduce bugs",
  "type": "module",
  "keywords": [
    "playground",
    "sandbox",
    "code",
    "debug",
    "learn",
    "reproduce",
    "bugs",
    "component",
    "storybook-addons"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mondaycom/storybook-addon-playground"
  },
  "storybook": {
    "displayName": "Playground",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "author": "Vibe",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "build": "rollup -c",
    "build:watch": "yarn build -- -w",
    "build:icons": "yarn svgr --typescript --no-svgo --out-dir src/icons",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "yarn lint -- --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "yarn build && yarn storybook"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@storybook/addon-links": "^9.0.0",
    "@uiw/codemirror-extensions-langs": "^4.23.0",
    "@uiw/codemirror-theme-github": "^4.23.0",
    "@uiw/react-codemirror": "^4.23.0",
    "classnames": "^2.5.1",
    "lz-string": "^1.5.0",
    "prettier": "^3.6.2",
    "react-live": "^4.1.8",
    "style-inject": "^0.3.0"
  },
  "resolutions": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@lezer/common": "1.2.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/git": "^9.0.1",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.12.0",
    "@types/prettier": "^3.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vibe/core": "3.61.0",
    "@vibe/icons": "1.10.0",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "react": "^18.0.0",
    "react-docgen": "^8.0.1",
    "react-dom": "^18.0.0",
    "rollup": "^4.47.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "sass": "^1.90.0",
    "storybook": "^9.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
